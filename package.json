{
  "name": "limpa-tudo",
  "description": "Ajuda a liberar espaço em disco no macOS e Linux com segurança",
  "author": "Ricardo Glodzinski",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "predev:electron": "mkdir -p dist-electron && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "dev:electron": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "dev": "concurrently -k -n renderer,electron,app -c blue,yellow,green \"npm:dev:renderer\" \"npm:dev:electron\" \"wait-on tcp:5173 dist-electron/main.js && electron .\"",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish=never",
    "dist:mac": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64 --publish=never && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish=never",
    "dist:mac:signed": "npm run build && electron-builder --mac --x64 --publish=never && electron-builder --mac --arm64 --publish=never",
    "dist:mas": "npm run build && electron-builder --mac mas --publish=never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb rpm snap tar.gz --publish=never",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.rglodzinski.limpatudo",
    "productName": "Limpa Tudo",
    "icon": "build/icon.png",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "catalog/**/*"
    ],
    "extraResources": [
      {
        "from": "catalog",
        "to": "catalog"
      },
      {
        "from": "build/tray",
        "to": "tray"
      }
    ],
    "afterSign": "build/notarize.cjs",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "mas": {
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/limpatudo.provisionprofile"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "snap",
        "tar.gz"
      ],
      "category": "Utility",
      "maintainer": "Ricardo Glodzinski <rglodzinski@gmail.com>"
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.32.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "recharts": "^3.10.1",
    "sudo-prompt": "^9.2.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true
  }
}
